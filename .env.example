# Required. Stays on the server; the browser only ever gets a short lived token.
REACTOR_API_KEY=replace_with_your_reactor_api_key

# Optional. Shared rooms for two screen sessions when the app runs on more than
# one server instance (Vercel). The "Upstash for Redis" integration on Vercel
# sets both of these for you. Leave them out to keep rooms in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional. Set to "off" to stop minting Orbis sessions, for example once the
# credits are gone. Everything else keeps working.
# THRESHOLD_LIVE=off
